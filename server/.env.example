# ============================================================
# Dashboard9 Alert Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# PostgreSQL connection string for your LOCAL database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example: postgresql://postgres:mypassword@localhost:5432/alert_management
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/alert_management

# Port the Express server will listen on
PORT=5000

# CORS origin — the IP/URL of your mobile app / Expo dev server
# For local development with Expo Go, this is usually *
CORS_ORIGIN=*
