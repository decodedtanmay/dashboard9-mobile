{
  "expo": {
    "name": "MahaJal IoT",
    "slug": "dashboard9-mobile",
    "scheme": "mahajal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.mahajal.dashboard9.mobile"
    },
    "android": {
      "package": "in.mahajal.dashboard9.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1565C0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "",
      "useMockRepositories": true
    }
  }
}
